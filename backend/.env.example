# Copy this file to .env and fill values
MONGO_URI=mongodb+srv://Anteneh:<dbabk1996>@cluster0.xurbrp5.mongodb.net/?appName=Cluster0
JWT_SECRET=replace_with_a_strong_secret
# Prefer explicit access/refresh secrets
JWT_ACCESS_SECRET=replace_with_access_secret
JWT_REFRESH_SECRET=replace_with_refresh_secret
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=7d

CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Cloudinary upload options
CLOUDINARY_FOLDER=abk/services
IMAGE_MAX_WIDTH=1600
IMAGE_QUALITY=80
PORT=5000

# Optional security settings for production
# Comma-separated list of allowed origins for CORS, e.g. 'https://app.example.com,http://localhost:3000'
ALLOWED_ORIGINS=
# Optional cookie domain for refreshToken (e.g. .example.com)
# Optional: when set to a base domain (e.g. .example.com) cookies will be shared across subdomains
# In development keep this blank (or unset) to use host-scoped cookies (recommended)
COOKIE_DOMAIN=
# SameSite value for refresh cookie: 'Strict' | 'Lax' | 'None'
COOKIE_SAMESITE=Strict
# Force cookie secure flag in non-production environments (set to 'true' to force)
COOKIE_SECURE=

